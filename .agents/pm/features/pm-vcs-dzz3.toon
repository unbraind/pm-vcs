      created_at: "2026-08-28T15:10:48.756Z"
      source_kind: local_mutation
      source_ref: feat/patch-series-and-served-forge
  - command: "PM_PATH=/tmp/pmvcs-dzz3 PM_GLOBAL_PATH=/tmp/pmvcs-dzz3-g node --test --test-name-pattern \"two reviewers writing different fields of one review record merge cleanly\" test/review.test.ts"
    scope: project
    provenance:
      author: claude
      created_at: "2026-08-28T15:37:50.554Z"
      source_kind: local_mutation
      source_ref: feat/patch-series-and-served-forge
    assert_stdout_regex[1]: pass 1
    note: per-field merge across two real branches
  - command: "PM_PATH=/tmp/pmvcs-dzz3 PM_GLOBAL_PATH=/tmp/pmvcs-dzz3-g node --test --test-name-pattern \"a genuinely conflicting scalar field is reported as a conflict\" test/review.test.ts"
    scope: project
    provenance:
      author: claude
      created_at: "2026-08-28T15:37:50.554Z"
      source_kind: local_mutation
      source_ref: feat/patch-series-and-served-forge
    assert_stdout_regex[1]: pass 1
    note: a real conflict is still a conflict
docs[2]{path,scope,note}:
