{"ts":"2026-07-30T10:51:49.000Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"4f0b476f130948714074f357","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-30T10:51:49.000Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-07-30T10:51:49.000Z","author":"harness:claude-code","text":"mergeItemDocuments accepts an empty base but rejects an empty ours or theirs ('not a readable item document'). That maps exactly onto git's behaviour: add/add IS handed to a driver with an empty base file, while delete/modify is settled at the tree level and never reaches a driver. So the preview must not call the primitive when a side's blob is absent; it reports delete_modify instead. Probed against real item blobs rather than assumed, after a test failed on the empty-side throw."}]}],"before_hash":"6103d44f5e0f28d0a29eb199224472ad1b337b2d762e29b8b55d5db4f03599ba","after_hash":"adf792b5f6c7580e5c6c89863fd815b0bbd6516270ba13404e0563e6ee2a2e11"}
