{"ts":"2026-08-31T11:18:08.960Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_instance":"c41a528b9f424137989cc889","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-zhlz"},{"op":"add","path":"/metadata/title","value":"This repository has never produced a static analysis, because it runs no CodeQL workflow"},{"op":"add","path":"/metadata/description","value":"This repository ran no CodeQL workflow at all, so it had never produced a static analysis, and a repository nothing scans is indistinguishable from a repository with no findings in any dashboard that counts alerts. Sourcery found this while reviewing the dependabot grouping change on this branch: it pointed out that a codeql-action group is inert here because there are no github/codeql-action references for Dependabot to discover and combine. That was correct, and the grouping alone would have been a no-op. Measured 2026-08-31 across the fleet: nine repositories carrying this branch had no codeql workflow. Adds a weekly plus push and pull-request CodeQL analysis for javascript-typescript with build-mode none, pinned to the same codeql-action revision the group will keep in lockstep, on a cron minute and hour unique to this repository so the fleet does not fire every scan in the same minute."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T11:18:08.960Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T11:18:08.960Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","af