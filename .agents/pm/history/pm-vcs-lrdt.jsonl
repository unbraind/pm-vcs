{"ts":"2026-09-08T20:33:27.584Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5","agent_model_source":"probe","agent_instance":"d015d45b98771cb3763e159d","agent_provenance":{"model":{"value":"claude-opus-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.263","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-lrdt"},{"op":"add","path":"/metadata/title","value":"Reuse unaffected fragments across an edit with content-defined chunking"},{"op":"add","path":"/metadata/description","value":"The fragment path chunks at a fixed size, so inserting bytes near the start of a file shifts every subsequent boundary and re-stores every fragment. Content-defined chunking picks boundaries from the content itself, so an edit re-stores only the fragments it actually touched. Both modes need to coexist: fixed chunks are what make a byte-range read cheap, because the fragment covering an offset is computable rather than searched."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["fragments","scale"]},{"op":"add","path":"/metadata/created_at","value":"2026-09-08T20:33:27.584Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-09-08T20:33:27.584Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Inserting bytes into a large file re-stores only the fragments overlapping the edit, asserted by counting object files on disk before and after rather than by a reported statistic; fixed-size chunking remains available and range reads over it stay O(fragments in range); the chosen mode is recorded in the manifest so a reader does not have to infer it"},{"op":"add","path":"/metadata/parent","value":"pm-vcs-b7cb"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"6bd78dc6395a00a992b707e57a0f6f019e39ab6000a01f12c3e70dd8b82a7cbc","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"05bfc3a9315bbe48b5d7047ace8dc195a002bfd54b7eafa3085df46b3952f083"}
