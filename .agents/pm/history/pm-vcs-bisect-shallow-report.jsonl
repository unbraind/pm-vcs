y-tree ancestor A, good G with parent A, side S with parent A, and merge M with parents G and S. Clone M with depth 2 so A is absent and G/S are shallow. Initialize a real tracker and linked test in the clone. Start bisect G M, mark S bad, then request status."},{"op":"add","path":"/metadata/expected_result","value":"Keep the core bisect conclusion available and report unavailable file-derived attribution explicitly instead of throwing or inventing provenance."},{"op":"add","path":"/metadata/actual_result","value":"Start succeeds; marking S bad and later status both fail with No object for the omitted first-parent commit. The disposable reproduction verified the parent object is absent."},{"op":"add","path":"/metadata/component","value":"bisect"},{"op":"add","path":"/metadata/files","value":[{"path":"bisect-commands.ts","scope":"project"}]},{"op":"add","path":"/metadata/docs","value":[{"path":"docs/bisect.md","scope":"project"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"c849488bf26c2561cf5fd873923968d741b6f052f03e5a451ded3df135b114cd","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"c934983f750e259a463c069a3ea880fde3db2b82b1d61bbb6b258f72d1c19d62"}
