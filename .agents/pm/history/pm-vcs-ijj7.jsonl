{"ts":"2026-07-31T06:28:23.482Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"66076e2c28cfb4fafc6fb839","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-ijj7"},{"op":"add","path":"/metadata/title","value":"Phase 2: change identities and history rewriting"},{"op":"add","path":"/metadata/description","value":"A version control system that cannot rewrite history is a snapshot store. This phase gives every commit a change identity that survives rewriting, and adds describe, rebase, squash, split, cherry-pick, revert, reset and restore. Descendants are replayed automatically and every branch and tag pointing into a rewritten range is moved, so a rewrite can never orphan a ref. Every rewrite is one transactional operation-log entry, so undo reverses it whole."},{"op":"add","path":"/metadata/type","value":"Epic"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-07-31T06:28:23.482Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-31T06:28:23.482Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Every commit carries a change id that is preserved across describe, rebase, squash and split; rewriting a commit with descendants replays all of them and moves every affected branch and tag; a conflicting rewrite changes no ref and no working-tree byte; record paths merge per field during replay, never by line; 100 percent line, branch and function coverage"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"a8b699d64ece6d471aa2e6b9a529045282b1b8639839af79e36de9ac7fd49d12","message":""}
