{"ts":"2026-07-30T10:51:32.280Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"4f0b476f130948714074f357","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-jeun"},{"op":"add","path":"/metadata/title","value":"pm vcs items: map a commit range onto the pm items it touched"},{"op":"add","path":"/metadata/description","value":"Joins git history to the pm ledger so a PR description or release note can state which tracked work a branch represents."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["area:package","merge-safety"]},{"op":"add","path":"/metadata/created_at","value":"2026-07-30T10:51:32.280Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-30T10:51:32.280Z"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Items are classified created/modified/deleted with the earliest change deciding kind and a later deletion outranking it; history streams and settings are not double-counted; ordering is deterministic"},{"op":"add","path":"/metadata/parent","value":"pm-vcs-ghql"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"08a0d01620f42a2e3ced2280849f974b631890ef273bb2620b3bdc7ef07f7bc2","message":""}
{"ts":"2026-07-30T10:51:49.334Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"4f0b476f130948714074f357","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-30T10:51:49.334Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-07-30T10:51:49.334Z","author":"harness:claude-code","text":"git log --name-status -z separates a record's formatted header from its first name-status entry with a NEWLINE, not a NUL. Without trimming the status token the first changed path of every commit carries status '\\nA', which fails a startsWith('A') test and silently reports a newly added item as modified — a wrong answer in the exact field a changelog reads, not an error. Caught by the created/modified/deleted test."}]}],"before_hash":"08a0d01620f42a2e3ced2280849f974b631890ef273bb2620b3bdc7ef07f7bc2","after_hash":"a8134933e4beea91a801912c20c013d314e416ae24736cd6611106be229a9661"}
