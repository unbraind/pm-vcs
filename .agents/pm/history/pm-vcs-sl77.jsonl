{"hash_algorithm":"sha256","ts":"2026-10-05T09:04:49.913Z","author":"codex-sol","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"8ad42a18d3a4199ef0051c7f","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-sl77"},{"op":"add","path":"/metadata/title","value":"Honor disabled HTTP Date headers when serving with native Bun"},{"op":"add","path":"/metadata/description","value":"Separate native Bun compatibility finding from PR #91 path catalogue validation. Bun 1.3.5 emits an automatic Date header despite response.sendDate=false in engine/serve.ts; Node omits it. Two identical denial responses across a one-second refresh wait therefore differ only in Date. Status and denial body are identical, and no repository existence disclosure was observed. Investigate a portable omission or a bounded stable header policy and add a cross-second raw socket regression without altering the path catalogue."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T09:04:49.913Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T09:04:49.913Z"},{"op":"add","path":"/metadata/author","value":"codex-sol"},{"op":"add","path":"/metadata/parent","value":"pm-vcs-5h6j"},{"op":"add","path":"/metadata/repro_steps","value":"Run a native Bun server with response.sendDate=false; send the same denied POST twice more than one second apart; compare raw response headers. engine/serve.ts follows this pattern, and the new directory-replacement socket fixture reproduced differing Date values."},{"op":"add","path":"/metadata/expected_result","value":"The requested suppression of automatic Date headers is honored under both supported runtimes."},{"op":"add","path":"/metadata/actual_result","value":"Node omits Date; native Bun 1.3.5 emits a changing Date header."},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-vcs-ttc0","kind":"related","created_at":"2026-10-05T09:04:49.913Z","author":"codex-sol","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"bee2fbd96f9c85ee91389d61489787e1cf169ff570315c6eb71f8128a7581ea1","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"c9674b408ea6dfdd1344a44413b2f1653681e39757750895380653038cce1bbf"}
