{"ts":"2026-08-01T19:32:33.387Z","author":"harness:codex","author_source":"detected","agent_harness":"codex","agent_instance":"bd613e3795b0c557ce48f8b6","agent_provenance":{"model":null,"effort":null,"role":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-vmmx"},{"op":"add","path":"/metadata/title","value":"Stream arbitrary large files through fragment and range storage"},{"op":"add","path":"/metadata/description","value":"Replace whole-blob memory assumptions with versioned chunk-list objects, content-defined and fixed chunking modes, streaming reads and writes, byte-range access, resumable fragment transfer, and compression metadata separated from uncompressed content identity."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-01T19:32:33.387Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-01T19:32:33.387Z"},{"op":"add","path":"/metadata/author","value":"harness:codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Multi-gigabyte logical files can be staged transferred verified and restored within a fixed memory ceiling; Insertion into content-defined content reuses unaffected fragments while fixed chunks support direct range reads; Interrupted transfer resumes missing fragments and no ref advances before remote closure verification; Algorithm and threshold choices are justified by reproducible TypeScript benchmarks rather than copied constants"},{"op":"add","path":"/metadata/parent","value":"pm-vcs-b7cb"},{"op":"add","path":"/metadata/risk","value":"high"},{"op":"add","path":"/metadata/docs","value":[{"path":"docs/LORE_RESEARCH.md","scope":"project","note":"Epic Lore fragment storage analysis"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"