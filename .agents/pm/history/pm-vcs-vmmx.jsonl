{"ts":"2026-09-08T16:04:21.307Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"f74923b8edfd905213ed47e9","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-09-08T16:04:21.307Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-09-08T16:04:21.307Z","author":"pi-agent","text":"Implemented fragment and range storage in engine/fragments.ts and engine/model.ts. Added 'manifest' object kind to OBJECT_TYPES. Streaming write (writeFragmentedFile) reads source through fd in fixed-size chunks, never holds more than fragmentSize bytes. Streaming read (readFragmentedToFile) reads one fragment at a time. Range read (readFragmentRange) reads only overlapping fragments. Deduplication: fragments are content-addressed blobs in the existing ObjectStore; storing same content twice yields same fragment ids and no new files on disk. Measured: with 512 fragments x 4096 bytes (2 MiB file), peak additional heap after GC is ~16 KB for write and ~280 KB for read — well under file size / 4 (512 KB). Optimized ObjectStore.has to use statSync instead of readFileSync, and hashObject to hash incrementally without allocating a frame buffer. 100% coverage maintained. 48 new tests."}]}],"before_hash":"c8dc32331f781cf942891bf981fb72f4b11478b66c5824da3bb5aa0b66f9782b","after_hash":"99d592ffe95ac89693c3fa7df742786874abccc3b26cbb676c79f3ed7228820e","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"2740213c19eb1a2af8c53704fe53317dc77e9f149efa239f47b6b7e0d1a6fe1a"}
