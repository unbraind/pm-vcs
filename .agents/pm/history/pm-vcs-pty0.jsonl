{"ts":"2026-07-30T10:51:48.638Z","author":"harness:claude-code","author_source":"detected","agent_harness":"claude-code","agent_instance":"4f0b476f130948714074f357","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"learning_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-30T10:51:48.638Z"},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-07-30T10:51:48.638Z","author":"harness:claude-code","text":"A linked worktree does NOT need its own pm merge install. The package spec assumed every fresh worktree re-opens the driver hole; the test written to prove that failed, because git worktree add shares the repository's config file. The hole is real for git clone (CI, collaborators), not for git worktree add. Both halves are now pinned by tests against a real clone and a real worktree, and the module doc states the distinction rather than the intuition."}]}],"before_hash":"81ddcb358ca93cd471117b95a744a90a45ee636742ffe5057c06fbdab40a627f","after_hash":"4d3721044bdd33596e79b29e6e9bcb84ea2de515749fc14deb415445a597e7a6"}
