{"hash_algorithm":"sha256","ts":"2026-10-07T22:47:10.756Z","author":"codex-sol","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"5f9535ee1fab75a4a13d2402","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"xhigh","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-74qw"},{"op":"add","path":"/metadata/title","value":"Make sparse view widening and narrowing descriptor-safe against ancestor replacement"},{"op":"add","path":"/metadata/description","value":"Separate from PR 96 materializeTree/restore review scope. Repository.setView retains path-based rmSync/mkdirSync/writeFileSync/chmodSync after its preflight. A disposable fixture stages branch/leaf.txt, narrows to visible/**, then swaps branch for an outside-directory symlink at widening mkdirSync: setView(null) overwrites the outside sentinel. Apply the shared pinned-directory mutation boundary to widening/narrowing with deterministic race tests and preserve sparse preflight/view/index behavior."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":0},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-07T22:47:10.756Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-07T22:47:10.756Z"},{"op":"add","path":"/metadata/author","value":"codex-sol"},{"op":"add","path":"/metadata/expected_result","value":"Concurrent ancestor substitution refuses without changing outside or nested control state."},{"op":"add","path":"/metadata/actual_result","value":"Synthetic widening reproduction overwrote an independent outside sentinel."},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-vcs-nz10","kind":"related","created_at":"2026-10-07T22:47:10.756Z","author":"codex-sol","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/files","value":[{"path":"engine/repo.ts","scope":"project"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"688a9d40b3fd3318a5e05d67cacbc1df39618570bf540fff165b51c34faa4af3","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"0d8f29f6378967edf270ac393527816e34e53fec6fe3d306d0d7f164a75c1736"}
