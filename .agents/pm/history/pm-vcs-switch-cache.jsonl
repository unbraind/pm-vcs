{"hash_algorithm":"sha256","ts":"2026-10-18T10:20:47.215Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"f44ff4fa82c07c16f4f044ac","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-vcs-switch-cache"},{"op":"add","path":"/metadata/title","value":"Refused switches refresh the raw index before private-layer preflight"},{"op":"add","path":"/metadata/description","value":"Discovered while running isolated npm release:check for PR #122. switchTo calls status, which may refresh optional index stat observations, before assertLayersAcceptTree rejects a private-layer parent collision. HEAD, refs and working bytes are protected but raw index bytes change on refusal. Existing coverage is timing-dependent because it uses a warm stat cache. Force a valid cold index in the real repository fixture and preflight private layers before status can refresh it."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-18T10:20:47.215Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-18T10:20:47.215Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Real switch refusal preserves raw index, HEAD, refs, operations and private working bytes with optional stat observations absent. Regression fails with only preflight ordering reverted. Both unchanged release gates pass."},{"op":"add","path":"/metadata/parent","value":"pm-vcs-p7objects"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df