  "node --test --test-name-pattern=\"operational entry points enforce real audits through direct CLI processes\" test/exact-gates.test.ts",project,codex-agent,"2026-10-21T19:49:43.059Z",local_mutation,chore/reconcile-tracker-1021
  node --test test/self-host.test.ts,project,codex-agent,"2026-10-21T19:49:47.274Z",local_mutation,chore/reconcile-tracker-1021
