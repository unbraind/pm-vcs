      created_at: "2026-11-10T12:44:33.177Z"
      source_kind: local_mutation
  - command: timeout --kill-after=5s 1200 node --test --test-concurrency=2 --test-reporter=tap test/test-environment.test.ts
    scope: project
    timeout_seconds: 1200
    provenance:
